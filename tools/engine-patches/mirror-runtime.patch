+void TMSceneSync::setup_synchronizer_for(NS::ObjectHandle p_app_object_handle, NS::ObjectLocalId p_id) {
+	if (p_app_object_handle == scene_synchronizer.to_handle(this)) {
+		// The coordinator is registered to run process_jolt_physics in the POST
+		// phase, not to expose GDScript properties. on_init_synchronizer installs
+		// that process; contact snapshots use snapshot_get/set_custom_data.
+		// Keep the normal setup contract for every other registered object.
+		return;
+	}
+
+	GdSceneSynchronizer::setup_synchronizer_for(p_app_object_handle, p_id);
+}
